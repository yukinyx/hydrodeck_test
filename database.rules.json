{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "hydrodeck": {
      ".read": "auth != null",
      "reservoir": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email === 'esp32@esp32.com'"
      },
      "commands": {
        ".read": "auth != null",
        "$actuator": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".validate": "newData.hasChildren()",
          "$commandId": {
            ".validate": "newData.isString()"
          }
        }
      },
      "commandAcks": {
        ".read": "auth != null",
        "$requestId": {
          ".write": "auth != null && auth.token.email === 'esp32@esp32.com'",
          ".validate": "newData.isString() && (newData.val() === 'accepted' || newData.val() === 'running' || newData.val() === 'completed' || newData.val() === 'rejected' || newData.val() === 'timed_out')"
        }
      },
      "commandAckReasons": {
        "$requestId": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.email === 'esp32@esp32.com'",
          ".validate": "newData.isString()"
        }
      },
      "intervalSnapshots": {
        ".read": "auth != null",
        "$intervalKey": {
          "sessions": {
            "$batchNumber": {
              "reservoir": {
                ".validate": "newData.hasChildren(['level', 'full', 'online']) && newData.child('level').isString() && (newData.child('level').val() === 'full' || newData.child('level').val() === 'not_full') && newData.child('full').isBoolean() && newData.child('online').isBoolean()"
              },
              ".write": "auth != null && auth.token.email === 'esp32@esp32.com'",
              ".validate": "newData.hasChildren(['intervalKey', 'batchNumber', 'capturedAt', 'source', 'bed1', 'bed2']) && newData.child('intervalKey').val() === $intervalKey && newData.child('batchNumber').isNumber() && newData.child('capturedAt').isNumber() && newData.child('source').val() === 'esp32' && newData.child('bed1').child('temp').isNumber() && newData.child('bed1').child('ph').isNumber() && newData.child('bed1').child('tds').isNumber() && newData.child('bed1').child('water').isString() && newData.child('bed2').child('temp').isNumber() && newData.child('bed2').child('ph').isNumber() && newData.child('bed2').child('tds').isNumber() && newData.child('bed2').child('water').isString() && (!newData.child('bed1').hasChild('rainNodeOnline') || newData.child('bed1').child('rainNodeOnline').isBoolean()) && (!newData.child('bed2').hasChild('rainNodeOnline') || newData.child('bed2').child('rainNodeOnline').isBoolean())"
            }
          }
        }
      },
      "actuators": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email === 'esp32@esp32.com'",
        "$actuator": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.email === 'esp32@esp32.com'",
          ".validate": "newData.isBoolean()"
        }
      },
      "settings": {
        "$setting": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".validate": "newData.isNumber()"
        }
      },
      "waterPump1": { ".read": "auth != null", ".write": "auth != null", ".validate": "newData.isBoolean()" },
      "phUp1": { ".read": "auth != null", ".write": "auth != null", ".validate": "newData.isBoolean()" },
      "phDown1": { ".read": "auth != null", ".write": "auth != null", ".validate": "newData.isBoolean()" },
      "nutrient1": { ".read": "auth != null", ".write": "auth != null", ".validate": "newData.isBoolean()" },
      "waterPump2": { ".read": "auth != null", ".write": "auth != null", ".validate": "newData.isBoolean()" },
      "phUp2": { ".read": "auth != null", ".write": "auth != null", ".validate": "newData.isBoolean()" },
      "phDown2": { ".read": "auth != null", ".write": "auth != null", ".validate": "newData.isBoolean()" },
      "nutrient2": { ".read": "auth != null", ".write": "auth != null", ".validate": "newData.isBoolean()" },
      "growLight": { ".read": "auth != null", ".write": "auth != null", ".validate": "newData.isBoolean()" },
      "$reading": {
        ".write": "auth != null && auth.token.email === 'esp32@esp32.com'"
      }
    }
  }
}
