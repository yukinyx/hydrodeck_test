rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /hydrodeckSystems/{systemId}/metadata/{documentId} {
      allow read, write: if request.auth != null;
    }

    match /hydrodeckSystems/{systemId}/plantingRuns/{batchId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.batchNumber is int
        && request.resource.data.batchNumber > 0;
      allow update, delete: if false;
    }

    match /hydrodeckSystems/{systemId}/minuteLogs/{recordId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.recordId == recordId
        && request.resource.data.recordType == 'scheduled'
        && request.resource.data.intervalKey is string
        && request.resource.data.batchNumber is int
        && request.resource.data.source in ['esp32', 'app'];
      allow delete: if false;
    }
  }
}
